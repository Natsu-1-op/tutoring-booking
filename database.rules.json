{
  "rules": {
  "questionBankAccess": {
    "settings": {
      ".read": "auth != null && auth.token.email === '1843499931@qq.com'"
    },
    "links": {
      ".read": "auth != null && auth.token.email === '1843499931@qq.com'",
      "$token": {
        ".write": "auth != null && auth.token.email === '1843499931@qq.com'",
        ".validate": "$token.matches(/^[A-Za-z0-9_-]{32}$/) && newData.hasChildren(['label','createdAt','delivery'])",
        "label": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() >= now - 120000 && newData.val() <= now + 120000))"
        },
        "delivery": {
          ".read": "data.exists() && data.child('revoked').val() === false && data.child('expiresAt').val() > now && data.child('release').val() === root.child('questionBankAccess/settings').child('release').val()",
          ".validate": "newData.hasChildren(['expiresAt','revoked','release','key'])",
          "expiresAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() > now && newData.val() <= now + 2592120000))"
          },
          "revoked": {
            ".validate": "newData.isBoolean() && (data.val() !== true || newData.val() === true)"
          },
          "release": {
            ".validate": "newData.isString() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('questionBankAccess/settings').child('release').val()))"
          },
          "key": {
            ".validate": "newData.isString() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('questionBankAccess/settings').child('key').val()))"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  },
    "users": {
      ".read": "auth != null && auth.token.email === '1843499931@qq.com'",
      "$uid": {
        ".read": "auth != null && auth.token.email === '1843499931@qq.com'",
        ".write": "auth != null && (auth.token.email === '1843499931@qq.com' || (auth.uid === $uid && !data.exists()))",
        ".validate": "newData.hasChildren(['email','createdAt'])",
        "email": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 200 && newData.val().matches(/^[^@ ]+@[^@ ]+$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() >= now - 300000 && newData.val() <= now + 300000))"
        },
        "disabled": {
          ".read": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        },
        "bankAccess": {
          "active": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.token.email === '1843499931@qq.com')",
            ".validate": "newData.isBoolean()"
          },
          "expiresAt": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.token.email === '1843499931@qq.com')",
            ".validate": "newData.isNumber() && newData.val() <= now + 94608000000"
          },
          "days": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1095"
          },
          "updatedAt": {
            ".write": "auth != null && (auth.uid === $uid || auth.token.email === '1843499931@qq.com')",
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "key": {
            ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('bankAccess/active').val() === true && root.child('users').child($uid).child('bankAccess/expiresAt').val() > now && root.child('users').child($uid).child('disabled').val() !== true",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "release": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "$other": { ".validate": false }
        },
        "claimedCodes": {
          "$code": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          }
        },
        "bankMemory": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === '1843499931@qq.com')",
          ".write": "auth != null && auth.uid === $uid",
          "$qid": {
            ".validate": "newData.hasChildren(['updatedAt']) && newData.child('updatedAt').isNumber()",
            "state": {
              ".validate": "newData.isString() && (newData.val() === 'mastered' || newData.val() === 'wrong' || newData.val() === '')"
            },
            "star": { ".validate": "newData.isBoolean()" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "activation_codes": {
      ".read": "auth != null && auth.token.email === '1843499931@qq.com'",
      ".indexOn": ["createdAt"],
      "$code": {
        ".write": "auth != null && auth.token.email === '1843499931@qq.com'",
        ".validate": "$code.matches(/^[A-Z2-9]{4}-[A-Z2-9]{4}-[A-Z2-9]{4}$/) && newData.hasChildren(['days','durationMs','note','createdAt','createdBy','release','key'])",
        "days": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1095"
        },
        "durationMs": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 86400000 && newData.val() <= 94608000000"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() >= now - 300000 && newData.val() <= now + 300000))"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "revoked": {
          ".read": "auth != null",
          ".validate": "newData.isBoolean()"
        },
        "release": {
          ".validate": "newData.isString() && newData.val() === root.child('questionBankAccess/settings/release').val()"
        },
        "key": {
          ".read": "auth != null && root.child('activation_codes').child($code).child('claim/usedBy').val() === auth.uid",
          ".validate": "newData.isString() && newData.val() === root.child('questionBankAccess/settings/key').val()"
        },
        "claim": {
          ".read": "auth != null && (!data.exists() || data.child('usedBy').val() === auth.uid)",
          ".write": "auth != null && root.child('activation_codes').child($code).child('revoked').val() !== true && (!data.exists() || data.child('usedBy').val() === auth.uid)",
          ".validate": "newData.hasChildren(['usedBy','usedAt','expiresAt']) && newData.child('usedBy').val() === auth.uid && newData.child('usedAt').isNumber() && newData.child('usedAt').val() <= now + 300000 && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + root.child('activation_codes').child($code).child('durationMs').val() + 900000",
          "usedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "usedAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "system": {
      ".read": true,
      ".write": true,
      "activeYear": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}$/)" },
      "activeName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
      "$other": { ".validate": false }
    },
    "years": {
      ".read": true,
      "$year": {
        ".validate": "$year.matches(/^\\d{4}$/)",
        ".write": true,
        "slots": {
          "$slotId": {
            ".validate": "!data.exists() || !data.child('time').exists() || data.child('time').val() === newData.child('time').val() || (newData.parent().parent().child('metadata/restoreToken').isString() && newData.parent().parent().child('metadata/restoreToken').val() !== data.parent().parent().child('metadata/restoreToken').val()) || (((data.child('reserved').val() === false || !data.child('reserved').exists()) && (newData.child('reserved').val() === false || !newData.child('reserved').exists())) || (data.child('reserved').val() === true && newData.child('reserved').val() === true && data.child('reservationId').isString() && newData.child('reservationId').val() === data.child('reservationId').val() && data.parent().parent().child('reservations').child(data.child('reservationId').val()).child('slotId').val() === $slotId && data.parent().parent().child('reservations').child(data.child('reservationId').val()).child('status').val() !== 'canceled' && ((data.parent().parent().child('reservations').child(data.child('reservationId').val()).child('feeStatus').val() !== 'posted' && !data.parent().parent().child('reservations').child(data.child('reservationId').val()).child('feeRecordId').exists()) || (data.parent().parent().child('reservations').child(data.child('reservationId').val()).child('status').val() === 'completed' && newData.parent().parent().child('metadata/feeReconcileToken').isString() && newData.parent().parent().child('metadata/feeReconcileToken').val() !== data.parent().parent().child('metadata/feeReconcileToken').val() && newData.parent().parent().child('reservations').child(data.child('reservationId').val()).child('feeRecordId').val() === data.parent().parent().child('reservations').child(data.child('reservationId').val()).child('feeRecordId').val())) && newData.parent().parent().child('reservations').child(data.child('reservationId').val()).child('time').val() === newData.child('time').val() && newData.parent().parent().child('reservations').child(data.child('reservationId').val()).child('status').val() !== 'canceled'))",
            "time": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "reserved": { ".validate": "newData.isBoolean()" },
            "reservationId": { ".validate": "(newData.isString() && newData.val().length <= 100) || newData.val() === null" },
            "status": { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'hidden')" },
            "$other": { ".validate": false }
          }
        },
        "reservations": {
          "$resId": {
            "nickname": { ".validate": "newData.isString() && newData.val().matches(/^[^.#$\\/\\[\\]<>]{1,50}$/)" },
            "slotId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "reservationId": { ".validate": "newData.isString() && newData.val() === $resId" },
            "time": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "status": { ".validate": "newData.isString() && (newData.val() === 'booked' || newData.val() === 'confirmed' || newData.val() === 'completed' || newData.val() === 'canceled')" },
            "cancelCode": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{5}$/)" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "archived": { ".validate": "newData.isBoolean() || newData.val() === null" },
            "feeStatus": { ".validate": "newData.isString() && (newData.val() === 'posted' || newData.val() === 'pending' || newData.val() === 'dismissed')" },
            "feePostedAt": { ".validate": "newData.isNumber() || newData.val() === null" },
            "feeDismissedAt": { ".validate": "newData.isNumber() || newData.val() === null" },
            "feeRecordId": { ".validate": "(newData.isString() && newData.val().length <= 200) || newData.val() === null" },
            "slotSnapshot": { ".validate": "newData.hasChildren()" },
            "$other": { ".validate": false }
          }
        },
        "settings": {
          "$key": {
            ".validate": "newData.isString() || newData.isBoolean() || newData.isNumber() || newData.hasChildren()"
          }
        },
        "studentWhitelist": {
          "$id": {
            ".validate": "newData.isString() && newData.val().matches(/^[^.#$\\/\\[\\]<>]{1,50}$/)"
          }
        },
        "operationLog": {},
        "metadata": {},
        "dailyLocks": {},
        "studentHours": {
          "$name": {
            ".validate": "newData.isNumber() || newData.val() === null"
          }
        },
        "feeVault": {
          ".write": true
        },
        "feeVaultDeletedAt": {
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "$other": { ".validate": false }
      }
    },
    "examRankings": {
      ".read": true,
      ".write": true,
      "$paper": {
        "$student": {
          "name": { ".validate": "newData.isString() && newData.val().matches(/^[^.#$\\/\\[\\]<>]{1,50}$/)" },
          "paperTitle": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "time": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!newData.parent().child('maxScore').exists() || newData.val() <= newData.parent().child('maxScore').val())" },
          "maxScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "submittedExamLocks": {
      "$paper": {
        "$student": {
          ".read": true,
          ".write": "!data.exists() || (data.hasChildren(['status', 'clientToken']) && data.child('status').val() === 'pending' && (newData.child('clientToken').val() === data.child('clientToken').val() || now - data.child('createdAt').val() > 1800000) && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'submitted'))",
          ".validate": "newData.hasChildren(['status', 'clientToken', 'createdAt']) && newData.child('clientToken').isString() && newData.child('clientToken').val().length > 0 && newData.child('clientToken').val().length <= 200 && (newData.child('status').val() === 'pending' || (newData.child('status').val() === 'submitted' && newData.child('submittedAt').isNumber() && newData.child('receiptId').isString() && newData.child('receiptId').val().matches(/^EX-[A-Z2-9]{6}-[A-Z2-9]{6}$/)))",
          "status": { ".validate": "newData.isString()" },
          "clientToken": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "submittedAt": { ".validate": "newData.isNumber() || newData.val() === null" },
          "receiptId": { ".validate": "newData.isString() && newData.val().matches(/^EX-[A-Z2-9]{6}-[A-Z2-9]{6}$/)" },
          "$other": { ".validate": false }
        }
      }
    },
    "blinkConsole": {
      "config": {
        ".read": true,
        ".write": true,
        "noiseMultiplier": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12" },
        "refractoryMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
        "minDropCounts": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 200" },
        "manualThresholdEnabled": { ".validate": "newData.isBoolean()" },
        "manualDropCounts": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 2000" },
        "oledText": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "oledBitmap": { ".validate": "newData.isString() && newData.val().length <= 1200" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "updatedBy": { ".validate": "newData.isString() && newData.val().length <= 100" }
      }
    },
    "admin_auth": {
      ".read": false,
      ".write": false,
      "$token": {
        ".read": "data.val() === true"
      }
    }
  }
}
